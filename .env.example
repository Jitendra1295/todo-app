# Backend-only secret. Never prefix this with VITE_ or expose it in frontend code.
GEMINI_API_KEY=

# Server Port
PORT=3001

# Comma-separated frontend origins allowed to call the backend.
FRONTEND_URL=http://localhost:5173,http://localhost:5174

# Leave blank for local development (Vite proxies /api to the local Express server).
# Set this in Vercel to the deployed Render service URL, without a trailing slash.
VITE_API_BASE_URL=
